model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["risk_scoring_summary","investigation_queue","fraud_signal_performance","fraud_signal_combinations","fraud_by_type"]

annotation PBI_ProTooling = ["DevMode"]

ref table risk_scoring_summary
ref table investigation_queue
ref table fraud_signal_performance
ref table fraud_signal_combinations
ref table fraud_by_type

ref cultureInfo en-US

